# Which WP backend to use in local development: local | flywheel
PUBLIC_WP_SOURCE=local

PUBLIC_WP_GRAPHQL_URL_LOCAL=http://trichis.local/graphql
PUBLIC_WP_GRAPHQL_URL_FLYWHEEL=

# Optional override. If unset, derived from the resolved GraphQL URL minus /graphql
# plus /wp-json/trichis/v1/forms/{form_key}
# PUBLIC_WP_FORMS_ENDPOINT=http://trichis.local/wp-json/trichis/v1/forms

# DatoCMS read-only token (only needed for scripts/seed/export-datocms.mjs)
DATOCMS_READ_ONLY_API_TOKEN=

# Set to 1 to build pages from the exported seed JSON in scripts/seed/data
# instead of WordPress (useful before WP is installed/seeded)
USE_SEED_DATA=1
# Client-exposed mirror (forms mock success without hitting WP)
PUBLIC_USE_SEED_DATA=1
