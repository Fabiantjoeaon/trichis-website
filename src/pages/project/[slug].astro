---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ProjectPage from "@/components/project/ProjectPage.jsx";
import { getProject, getProjects } from "@/lib/content";

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project, index) => {
    const nextProjects = [1, 2]
      .map((step) => projects[(index + step) % projects.length])
      .filter((p, i, arr) => p && p.slug !== project.slug && arr.indexOf(p) === i);

    return {
      params: { slug: project.slug },
      props: { nextProjects },
    };
  });
}

const { nextProjects } = Astro.props;
const { slug } = Astro.params;

// The list query carries no blocks or SEO, so the page itself is fetched here.
const project = await getProject(slug);

if (!project) {
  return Astro.redirect("/404");
}
---

<BaseLayout title={project.title} seo={project.seo}>
  <ProjectPage client:load project={project} nextProjects={nextProjects} />
</BaseLayout>
