---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ServicePage from "@/components/service/ServicePage.jsx";
import { getPageByKey, getService, getServices } from "@/lib/content";

export async function getStaticPaths() {
  const services = await getServices();
  return services.map((s) => ({
    params: { slug: s.slug },
  }));
}

const { slug } = Astro.params;
const service = await getService(slug);

if (!service) {
  return Astro.redirect("/404");
}

// The service carousel at the foot of every service page reuses the one the
// editor configured on the homepage, so the list lives in a single place.
const home = await getPageByKey("home");
const servicesNav = (home?.content ?? []).find(
  (block) => block.__typename === "HomewhatwedoRecord",
);
---

<BaseLayout title={service.title} seo={service.seo}>
  <ServicePage client:load service={service} servicesNav={servicesNav} />
</BaseLayout>
