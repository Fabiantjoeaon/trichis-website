---
import BaseLayout from "@/layouts/BaseLayout.astro";
import CmsPage from "@/components/CmsPage.jsx";
import { getProjects, getPageByKey } from "@/lib/content";

const page = await getPageByKey("home");
const projects = await getProjects();
---

<BaseLayout title={page?.title} seo={page?.seo}>
  <CmsPage client:load content={page?.content ?? []} projects={projects} />
</BaseLayout>
