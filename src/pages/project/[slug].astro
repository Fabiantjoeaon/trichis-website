---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ProjectPage from "@/components/project/ProjectPage.jsx";
import { getProject, getProjects } from "@/lib/content";

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project, index) => {
    const nextProjects = [1, 2]
      .map((step) => projects[(index + step) % projects.length])
      .filter((p, i, arr) => p && p.slug !== project.slug && arr.indexOf(p) === i);

    return {
      params: { slug: project.slug },
      props: { project, nextProjects },
    };
  });
}

const { project, nextProjects } = Astro.props;
---

<BaseLayout title={`${project.title} — Nine Creative Agency`}>
  <ProjectPage client:load project={project} nextProjects={nextProjects} />
</BaseLayout>
