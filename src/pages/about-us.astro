---
import BaseLayout from "@/layouts/BaseLayout.astro";
import CmsPage from "@/components/CmsPage.jsx";
import { getPageByKey } from "@/lib/content";

const page = await getPageByKey("about");
---

<BaseLayout title={page?.title} seo={page?.seo}>
  <CmsPage client:load content={page?.content ?? []} />
</BaseLayout>
