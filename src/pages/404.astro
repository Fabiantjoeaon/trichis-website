---
import BaseLayout from "@/layouts/BaseLayout.astro";
import TransitionLink from "@/components/ui/TransitionLink.jsx";
import { getSiteSettings } from "@/lib/content";

let notFound = {};
try {
  notFound = (await getSiteSettings()).notFound ?? {};
} catch {
  // settings unavailable — render the shell without copy
}
---

<BaseLayout title={notFound.title} seo={{ noindex: true }} showFooter={false}>
  <section class="inner-width section-top section-bottom not-found">
    <h1>{notFound.title}</h1>
    {
      notFound.ctaText && (
        <TransitionLink client:load href={notFound.ctaLink || "/"}>
          {notFound.ctaText}
        </TransitionLink>
      )
    }
  </section>
</BaseLayout>

<style>
  .not-found {
    min-height: 60vh;
    display: flex;
    flex-direction: column;
    gap: 40rem;
    justify-content: center;
  }
</style>
