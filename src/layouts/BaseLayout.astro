---
import { ClientRouter } from "astro:transitions";
import "@/styles/global.css";
import "@/styles/chrome.css";
import "@/styles/pages.css";
import { SITE_LANG, SITE_LOCALE } from "@/lib/i18n";
import { getSiteSettings } from "@/lib/content";
import SiteChrome from "@/components/layout/SiteChrome.jsx";
import Footer from "@/components/layout/Footer.jsx";

const { title = "", seo, theme = "light", showFooter = true } = Astro.props;

let settings = {};
try {
  settings = await getSiteSettings();
} catch (err) {
  console.warn("[BaseLayout] site settings unavailable:", err?.message ?? err);
}

const general = settings.general ?? {};

// An explicit SEO title wins outright; otherwise the page title gets the
// site-wide suffix appended.
const pageTitle =
  seo?.title || `${title || general.siteName || ""}${general.seoTitleSuffix ?? ""}`;
const description = seo?.description || general.seoDefaultDescription || "";
const ogImage = seo?.ogImage || general.seoDefaultOgImage || null;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;
---

<!doctype html>
<!-- transition:animate="none" — the GL wipe is the page transition; disable
     the browser's default cross-fade -->
<html lang={SITE_LANG} data-theme={theme} transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    {description && <meta name="description" content={description} />}
    {seo?.noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    {general.favicon && <link rel="icon" href={general.favicon} />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    {description && <meta property="og:description" content={description} />}
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta property="og:url" content={canonical} />
    {general.siteName && (
      <meta property="og:site_name" content={general.siteName} />
    )}
    <meta property="og:locale" content={SITE_LOCALE.replace("-", "_")} />
    <meta name="twitter:card" content={ogImage ? "summary_large_image" : "summary"} />
    <link
      rel="preload"
      href="/fonts/SGGrotesk-ExLight.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/SGGrotesk-Regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/SGGrotesk-Medium.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <ClientRouter fallback="swap" />
    <slot name="head" />
  </head>
  <body>
    <!-- Covers the page before the React loader hydrates (nine-ca pattern) -->
    <div class="loader-background"></div>

    <SiteChrome
      client:load
      transition:persist="site-chrome"
      settings={settings}
      siteName={general.siteName ?? ""}
    />

    <div class="main-inner">
      <main>
        <slot />
      </main>
      {showFooter && <Footer client:visible settings={settings} />}
    </div>

    <script>
      // Fallback: never leave the static cover up if hydration fails.
      setTimeout(() => {
        document.querySelector(".loader-background")?.remove();
      }, 10000);
    </script>
  </body>
</html>

<style is:global>
  .loader-background {
    position: fixed;
    inset: 0;
    z-index: 9998;
    background-color: var(--color-menuBackground);
  }

  /* No overflow:hidden — nine-ca relies on the hero's own margin collapsing
     with this one (max wins), not stacking on top of it. */
  .main-inner {
    margin-top: var(--navigationHeight);
    background-color: var(--color-background);
  }
</style>
